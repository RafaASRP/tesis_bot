# ==========================================
# GovAssist Core - Strict Gitignore
# ==========================================

# 1. Archivos de sistema macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# 2. Entornos y Cachés de Python (Backend)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 3. Datos efímeros y Privacidad (LGPDPPSO)
backend/data/downloads/*
!backend/data/downloads/.gitkeep
backend/data/raw_docs/*.pdf
*.log

# 4. Next.js y Node.js (Frontend)
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 5. Entorno local y Secretos
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
.vercel

# 6. Playwright y RPA
test-results/
playwright-report/
blob-report/
playwright/.cache/
